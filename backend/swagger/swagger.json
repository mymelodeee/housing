{
  "openapi": "3.0.3",
  "info": {
    "title": "housing API",
    "version": "0.1.0",
    "description": "수도권(서울·경기·인천) 7~15억원대 아파트 탐색·비교 서비스 housing의 백엔드 API 명세. 인증 없는 단일 사용자 프로필 기반이며(도메인 정의서 §4.3, PRD §3), 아파트 단지(Apartment Complex)와 매물(Listing, 개별 판매 건)을 분리해 관리한다(도메인 정의서 v0.8 §1·§2). 각 엔드포인트 설명에 대응하는 도메인 정의서(1-domain-definition.md) 절 번호와 PRD(2-prd.md) 기능 번호(F1~F7)를 표기한다."
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "로컬 개발 서버 (4-project-principle.md 확정 스택 기준)" }
  ],
  "tags": [
    { "name": "complexes", "description": "아파트 단지 조회 (도메인 §4.1, §5.5)" },
    { "name": "listings", "description": "매물 조회 (도메인 §4.2, PRD F1)" },
    { "name": "regulation", "description": "규제/대출 분석 (도메인 §5.1~§5.2, PRD F4)" },
    { "name": "locality", "description": "입지 정보 (도메인 §3.5, PRD F5)" },
    { "name": "loan-simulation", "description": "대출 시뮬레이션 (도메인 §5.3~§5.4, PRD F6)" },
    { "name": "price-history", "description": "매매가 변동 이력 (도메인 §4.7, PRD F7)" },
    { "name": "favorites", "description": "즐겨찾기 (도메인 §4.4, PRD F2)" },
    { "name": "comparison-sets", "description": "비교셋 (도메인 §4.5, §5.5, PRD F3)" },
    { "name": "user-profile", "description": "내 정보(단일 사용자 프로필) (도메인 §4.3, PRD F6)" }
  ],
  "paths": {
    "/api/complexes": {
      "get": {
        "tags": ["complexes"],
        "summary": "아파트 단지 목록 조회",
        "description": "아파트 단지(도메인 §4.1) 목록을 조회한다. 지도/목록 화면(F1)에서 단지 단위 표시에 사용된다.",
        "responses": {
          "200": {
            "description": "단지 목록 (0건이어도 200 + 빈 배열, 에러 아님)",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ApartmentComplexSummary" } }
              }
            }
          }
        }
      }
    },
    "/api/complexes/{id}": {
      "get": {
        "tags": ["complexes"],
        "summary": "아파트 단지 상세 조회",
        "description": "단지 상세(연식/준공년도, 리모델링 이력, 재건축 추진현황, 주변 재개발 정보, 규제지역·토지거래허가구역 여부, 셔틀 정보, 입지 속성, 단지 시세)를 조회한다(도메인 §4.1, §5.5). 단지 시세는 저장값이 아닌 조회 시점 집계값이며, 매물이 0건이면 \"매물 없음\"으로 반환한다(도메인 §5.5, 실행계획 BE-8).",
        "parameters": [ { "$ref": "#/components/parameters/ComplexIdPath" } ],
        "responses": {
          "200": {
            "description": "단지 상세",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApartmentComplex" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/listings": {
      "get": {
        "tags": ["listings"],
        "summary": "매물 목록 조회 (매매가 필터)",
        "description": "매매가(만원) 구간으로 매물을 필터링해 조회한다(도메인 §4.2, §2 탐색 범위, PRD F1). 매물과 소속 단지(apartment_complexes)를 join하여 매물 자체 정보(매매가/전용면적)와 소속 단지 정보(연식/셔틀 통근시간 등)를 함께 반환한다. minLat/maxLat/minLng/maxLng를 4개 모두 지정하면 소속 단지 좌표 기준 지도 bbox 필터가 추가로 적용된다(지도 화면(F1)에서 뷰포트 내 매물만 조회할 때 사용, 실행계획 FE-3).",
        "parameters": [
          { "name": "minPrice", "in": "query", "description": "최소 매매가(만원). 미지정 시 기본값 70000", "required": false, "schema": { "type": "integer", "minimum": 70000, "maximum": 150000, "default": 70000, "example": 70000 } },
          { "name": "maxPrice", "in": "query", "description": "최대 매매가(만원). 미지정 시 기본값 150000", "required": false, "schema": { "type": "integer", "minimum": 70000, "maximum": 150000, "default": 150000, "example": 150000 } },
          { "name": "minLat", "in": "query", "description": "지도 bbox 필터 최소 위도. minLat/maxLat/minLng/maxLng 4개를 모두 지정해야 적용된다(하나라도 누락 시 bbox 필터 미적용).", "required": false, "schema": { "type": "number", "format": "double", "example": 37.15 } },
          { "name": "maxLat", "in": "query", "description": "지도 bbox 필터 최대 위도", "required": false, "schema": { "type": "number", "format": "double", "example": 37.25 } },
          { "name": "minLng", "in": "query", "description": "지도 bbox 필터 최소 경도", "required": false, "schema": { "type": "number", "format": "double", "example": 127.05 } },
          { "name": "maxLng", "in": "query", "description": "지도 bbox 필터 최대 경도", "required": false, "schema": { "type": "number", "format": "double", "example": 127.15 } }
        ],
        "responses": {
          "200": {
            "description": "조건에 맞는 매물 목록. 조건에 맞는 매물이 0건이면 에러가 아닌 200과 빈 배열을 반환한다(도메인 §3.1, PRD F1 인수조건: \"조건에 맞는 매물이 0건입니다\")",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Listing" } } } }
          }
        }
      }
    },
    "/api/listings/{id}": {
      "get": {
        "tags": ["listings"],
        "summary": "매물 상세 조회 (+소속 단지 정보)",
        "description": "매물 상세와 소속 단지(apartment_complexes) 정보를 함께 조회한다(도메인 §4.2).",
        "parameters": [ { "$ref": "#/components/parameters/ListingIdPath" } ],
        "responses": {
          "200": { "description": "매물 상세", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Listing" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/listings/{id}/regulation": {
      "get": {
        "tags": ["regulation"],
        "summary": "매물 상세 - 규제/대출 분석 (F4)",
        "description": "매물이 속한 단지의 규제 현황(토지거래허가구역, 투기과열지구/조정대상지역 여부)과 매물 매매가를 기준으로 산출한 최대 대출가능금액, 갭투자 가능 여부, 실거주 필수 기간을 반환한다(도메인 §3.4, §5.1~§5.2, PRD F4). 소속 단지의 토지거래허가구역 여부가 미고시(null)이면 \"확인필요\" 상태를, 규제지역 여부가 미확정(예: 평택)이면 임시로 비규제지역 LTV(하한값)를 적용했음을 안내한다(PRD F4 인수조건). \"내 정보\"(사용자 프로필) 미입력 상태에서는 규제 현황은 정상 반환하되 최대 대출가능금액은 null과 함께 \"내 정보 입력 필요\" 안내를 반환한다(실행계획 BE-4-3, PRD F6과의 경계).",
        "parameters": [ { "$ref": "#/components/parameters/ListingIdPath" } ],
        "responses": {
          "200": { "description": "규제/대출 분석 결과", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegulationInfo" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/listings/{id}/locality": {
      "get": {
        "tags": ["locality"],
        "summary": "매물 상세 - 입지 정보 (F5)",
        "description": "매물이 속한 단지 기준의 입지 축(교통/상권/학군/강남 접근성/유흥·공원/개발호재/주변일자리)과 단지 기본정보(연식/리모델링/재건축/주변 재개발 정보)를 조회한다(도메인 §3.5, PRD F5). 소속 단지의 `locality_attributes`에 값이 없는 축은 \"정보 없음\"으로 반환한다.",
        "parameters": [ { "$ref": "#/components/parameters/ListingIdPath" } ],
        "responses": {
          "200": { "description": "입지 정보", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LocalityInfo" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/listings/{id}/loan-simulation": {
      "get": {
        "tags": ["loan-simulation"],
        "summary": "매물 상세 - 대출 시뮬레이션 (F6)",
        "description": "저장된 사용자 프로필(명의 구성/소득/성과금/자본금/세대 주택 보유 구분)과 매물 매매가, 소속 단지의 규제 정보를 기준으로 부부합산 vs 단독명의 두 시나리오의 최대 대출가능금액과 10/20/30년 원리금균등상환액을 계산·비교한다(도메인 §3.6, §5.3~§5.4, PRD F6). \"내 정보\" 미입력 상태에서는 에러가 아닌 200과 `profileIncomplete: true`를 반환한다(PRD F6 인수조건, 실행계획 BE-6-2).",
        "parameters": [ { "$ref": "#/components/parameters/ListingIdPath" } ],
        "responses": {
          "200": {
            "description": "대출 시뮬레이션 결과 (프로필 미입력 시 profileIncomplete 상태 포함)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoanSimulationResult" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/listings/{id}/price-history": {
      "get": {
        "tags": ["price-history"],
        "summary": "매물 상세 - 매매가 변동 이력 (F7, 단지 기준)",
        "description": "매물이 속한 단지 단위로 관리되는 국토교통부 아파트 실거래가 공개시스템(오픈API) 기반 최근 20년 매매가 변동 이력을 조회한다(도메인 §3.7, §4.7, PRD F7). 단지의 실거래 데이터가 20년 미만이면 최초거래 시점 이후 데이터만 반환하고, 데이터가 0건이면 빈 배열과 함께 \"실거래 이력 없음\"을 반환한다.",
        "parameters": [ { "$ref": "#/components/parameters/ListingIdPath" } ],
        "responses": {
          "200": { "description": "매매가 변동 이력", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PriceHistoryResponse" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/favorites/complexes": {
      "get": {
        "tags": ["favorites"],
        "summary": "단지 즐겨찾기 목록 조회",
        "description": "단일 사용자 프로필의 단지 즐겨찾기 목록을 단지 정보와 함께 조회한다(도메인 §3.2, §4.4, PRD F2). 매물 즐겨찾기와 완전히 독립된 목록이다.",
        "responses": {
          "200": { "description": "단지 즐겨찾기 목록", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/FavoriteComplex" } } } } }
        }
      },
      "post": {
        "tags": ["favorites"],
        "summary": "단지 즐겨찾기 추가",
        "description": "단지를 즐겨찾기에 추가한다(도메인 §4.4). (user_profile_id, complex_id) 조합은 유니크하다.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["complexId"], "properties": { "complexId": { "type": "integer", "example": 1 } } } } }
        },
        "responses": {
          "201": { "description": "추가된 즐겨찾기", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FavoriteComplex" } } } },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "이미 즐겨찾기된 단지에 재요청(도메인 §4.4 UNIQUE 제약, 시나리오 2-2)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "message": "이미 즐겨찾기에 추가된 단지입니다" } } }
          }
        }
      }
    },
    "/api/favorites/complexes/{complexId}": {
      "delete": {
        "tags": ["favorites"],
        "summary": "단지 즐겨찾기 해제",
        "description": "단지 즐겨찾기를 해제한다(도메인 §3.2, §4.4).",
        "parameters": [ { "name": "complexId", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 } ],
        "responses": {
          "200": { "description": "해제 완료" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/favorites/listings": {
      "get": {
        "tags": ["favorites"],
        "summary": "매물 즐겨찾기 목록 조회",
        "description": "단일 사용자 프로필의 매물 즐겨찾기 목록을 매물+소속 단지 정보와 함께 조회한다(도메인 §3.2, §4.4, PRD F2). 단지 즐겨찾기와 완전히 독립된 목록이다.",
        "responses": {
          "200": { "description": "매물 즐겨찾기 목록", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/FavoriteListing" } } } } }
        }
      },
      "post": {
        "tags": ["favorites"],
        "summary": "매물 즐겨찾기 추가",
        "description": "매물을 즐겨찾기에 추가한다(도메인 §4.4). (user_profile_id, listing_id) 조합은 유니크하다.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["listingId"], "properties": { "listingId": { "type": "integer", "example": 10 } } } } }
        },
        "responses": {
          "201": { "description": "추가된 즐겨찾기", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FavoriteListing" } } } },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "이미 즐겨찾기된 매물에 재요청(도메인 §4.4 UNIQUE 제약, 시나리오 2-2)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "message": "이미 즐겨찾기에 추가된 매물입니다" } } }
          }
        }
      }
    },
    "/api/favorites/listings/{listingId}": {
      "delete": {
        "tags": ["favorites"],
        "summary": "매물 즐겨찾기 해제",
        "description": "매물 즐겨찾기를 해제한다(도메인 §3.2, §4.4).",
        "parameters": [ { "name": "listingId", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 10 } ],
        "responses": {
          "200": { "description": "해제 완료" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/comparison-sets": {
      "get": {
        "tags": ["comparison-sets"],
        "summary": "내 비교셋 목록 조회",
        "description": "단일 사용자 프로필(id=1) 기준으로 생성된 모든 비교셋을 최신순으로 반환한다. 각 항목은 대상 개수와 대상 이름 목록을 요약해서 포함한다(도메인 §4.5). 비교셋이 없으면 빈 배열을 반환한다.",
        "responses": {
          "200": {
            "description": "비교셋 요약 목록",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ComparisonSetSummary" } } } }
          }
        }
      },
      "post": {
        "tags": ["comparison-sets"],
        "summary": "비교셋 생성 (단지 비교 / 매물 비교)",
        "description": "비교 대상 유형(targetType: complex/listing)을 선택해 비교셋을 생성한다(도메인 §3.3, §4.5, PRD F3). targetType이 'complex'이면 complexIds를, 'listing'이면 listingIds를 사용하며 하나의 비교셋 내 대상은 동일 유형이어야 한다(단지/매물 혼합 불가).",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ComparisonSetCreateRequest" } } }
        },
        "responses": {
          "201": { "description": "생성된 비교셋", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ComparisonSetDetail" } } } },
          "400": {
            "description": "대상 개수가 2개 미만이거나 6개 이상인 경우(도메인 §4.5, PRD F3 인수조건)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "examples": {
                  "tooFew": { "value": { "message": "비교하려면 2개 이상 선택해야 합니다" } },
                  "tooMany": { "value": { "message": "비교셋은 최대 5개까지 선택할 수 있습니다" } }
                }
              }
            }
          }
        }
      }
    },
    "/api/comparison-sets/{id}": {
      "get": {
        "tags": ["comparison-sets"],
        "summary": "비교셋 상세 조회 (단지 비교 / 매물 비교 데이터)",
        "description": "비교셋의 target_type에 따라 응답이 분기된다(도메인 §5.5, PRD F3). **단지 비교**는 단지 기본정보(연식/리모델링/재건축/주변 재개발 정보)와 입지 축, 단지 시세(매물 0건 시 \"매물 없음\")를 단지별로 반환한다. **매물 비교**는 매물 자체 속성(매매가/전용면적)과 소속 단지의 동일 축 정보를 매물별로 조합해 반환한다. 동일 단지 내 매물끼리 비교하는 경우 단지 축 값이 모든 대상에서 동일하게 반환되는 것은 정상 동작이다(도메인 §5.5).",
        "parameters": [ { "$ref": "#/components/parameters/ComparisonSetIdPath" } ],
        "responses": {
          "200": { "description": "비교셋 상세", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ComparisonSetDetail" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/comparison-sets/{id}/complexes": {
      "post": {
        "tags": ["comparison-sets"],
        "summary": "비교셋에 단지 추가 (단지 비교 전용)",
        "description": "targetType이 'complex'인 비교셋에 단지를 추가한다(도메인 §3.3, §4.5). 이미 포함된 단지를 다시 추가하면 (comparison_set_id, complex_id) UNIQUE 위반으로 409 \"중복입니다\"를 반환하고 추가하지 않는다.",
        "parameters": [ { "$ref": "#/components/parameters/ComparisonSetIdPath" } ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["complexId"], "properties": { "complexId": { "type": "integer", "example": 2 } } } } }
        },
        "responses": {
          "201": { "description": "추가 후 비교셋 상세", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ComparisonSetDetail" } } } },
          "400": { "description": "6개 이상이 되는 추가 시도(도메인 §4.5, PRD F3 인수조건)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "message": "비교셋은 최대 5개까지 선택할 수 있습니다" } } } },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "이미 포함된 단지를 동일 비교셋에 재추가 시도(도메인 §3.3 \"중복입니다\")",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "message": "중복입니다" } } }
          }
        }
      }
    },
    "/api/comparison-sets/{id}/listings": {
      "post": {
        "tags": ["comparison-sets"],
        "summary": "비교셋에 매물 추가 (매물 비교 전용)",
        "description": "targetType이 'listing'인 비교셋에 매물을 추가한다(도메인 §3.3, §4.5). 동일 단지에 속한 매물끼리 추가하는 것도 허용된다. 이미 포함된 매물을 다시 추가하면 (comparison_set_id, listing_id) UNIQUE 위반으로 409 \"중복입니다\"를 반환하고 추가하지 않는다.",
        "parameters": [ { "$ref": "#/components/parameters/ComparisonSetIdPath" } ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["listingId"], "properties": { "listingId": { "type": "integer", "example": 11 } } } } }
        },
        "responses": {
          "201": { "description": "추가 후 비교셋 상세", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ComparisonSetDetail" } } } },
          "400": { "description": "6개 이상이 되는 추가 시도(도메인 §4.5, PRD F3 인수조건)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "message": "비교셋은 최대 5개까지 선택할 수 있습니다" } } } },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "이미 포함된 매물을 동일 비교셋에 재추가 시도(도메인 §3.3 \"중복입니다\")",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "message": "중복입니다" } } }
          }
        }
      }
    },
    "/api/user-profile": {
      "get": {
        "tags": ["user-profile"],
        "summary": "내 정보(단일 사용자 프로필) 조회",
        "description": "고정 id=1인 단일 사용자 프로필을 조회한다(도메인 §4.3, PRD F6). 미입력 상태에서도 200과 null 필드가 포함된 객체를 반환한다(에러 아님).",
        "responses": {
          "200": { "description": "사용자 프로필", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserProfile" } } } }
        }
      },
      "put": {
        "tags": ["user-profile"],
        "summary": "내 정보(단일 사용자 프로필) 수정",
        "description": "명의 구성/연소득/성과금/자본금/세대 주택 보유 구분/생애최초 해당 여부/근무지를 수정한다(도메인 §3.6, §4.3, PRD F6). 수정 즉시 대출 시뮬레이션이 최신값 기준으로 재계산된다.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserProfileUpdateRequest" } } }
        },
        "responses": {
          "200": { "description": "수정된 사용자 프로필", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserProfile" } } } },
          "400": {
            "description": "housingOwnershipTier가 '무주택'이 아닌데 isFirstTimeBuyer=true인 경우, 또는 workplace가 '화성'/'평택'/null 외의 값인 경우(도메인 §4.6, 실행계획 BE-6-1)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ComplexIdPath": { "name": "id", "in": "path", "required": true, "description": "아파트 단지 ID", "schema": { "type": "integer" }, "example": 1 },
      "ListingIdPath": { "name": "id", "in": "path", "required": true, "description": "매물 ID", "schema": { "type": "integer" }, "example": 10 },
      "ComparisonSetIdPath": { "name": "id", "in": "path", "required": true, "description": "비교셋 ID", "schema": { "type": "integer" }, "example": 1 }
    },
    "responses": {
      "NotFound": {
        "description": "존재하지 않는 id (도메인/PRD 공통 규칙)",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "존재하지 않는 리소스입니다" }
        },
        "required": ["message"]
      },
      "RemodelingStatus": { "type": "string", "enum": ["해당없음", "추진중", "완료"], "example": "해당없음" },
      "ReconstructionStatus": {
        "type": "string",
        "description": "재건축 추진현황 7단계(도메인 §4.1)",
        "enum": ["해당없음", "추진위원회", "조합설립인가", "사업시행인가", "관리처분인가", "이주철거중", "착공"],
        "example": "해당없음"
      },
      "LandTransactionPermissionZoneStatus": {
        "description": "토지거래허가구역 여부. 미고시 지역은 null이며 이 경우 서비스는 \"확인필요\" 배지를 표시한다(도메인 §4.1)",
        "oneOf": [
          { "type": "boolean" },
          { "type": "string", "enum": ["확인필요"] }
        ],
        "example": true
      },
      "LocalityAttributes": {
        "type": "object",
        "description": "입지 속성. 값이 없는 축은 \"정보 없음\"으로 채워 반환한다(도메인 §4.1, 실행계획 BE-5/BE-8). schoolDistrict/entertainmentAndParks는 단지에 수동 입력된 값이 있으면 그 값을 그대로 우선 반환하고, 값이 없을 때만(즉 \"정보 없음\"일 때만) 공공데이터 API로 700m 반경을 실시간 조회해 채운다.",
        "properties": {
          "transportation": { "type": "string", "example": "지하철 SRT 동탄역 도보 10분, 광역버스 다수" },
          "commercialArea": { "type": "string", "example": "정보 없음" },
          "schoolDistrict": {
            "type": "string",
            "description": "단지 좌표 기준 700m 이내 가장 가까운 초등학교명과 거리. 수동 입력 값이 없을 때 전국초중등학교위치표준데이터(data.go.kr 15021148)로 실시간 계산한다. 700m 이내 학교가 없으면 \"정보 없음\".",
            "example": "동탄중앙초등학교 (350m 이내)"
          },
          "gangnamAccessibility": { "type": "string", "example": "SRT 이용 시 강남 접근 30분대" },
          "entertainmentAndParks": {
            "type": "string",
            "description": "단지 좌표 기준 700m 이내 일반유흥주점업 존재 여부. 수동 입력 값이 없을 때 소상공인시장진흥공단 상가(상권)정보 API(B553077 storeListInRadius)로 실시간 조회한다. 공원 정보는 이 필드에서 다루지 않는다(범위 제외).",
            "example": "유흥주점 없음 (700m 이내)"
          },
          "developmentProspects": { "type": "string", "example": "GTX-A 동탄역 개통 예정" },
          "nearbyJobs": { "type": "string", "example": "삼성전자 화성캠퍼스" }
        }
      },
      "PriceRange": {
        "description": "단지 시세. 해당 단지에 속한 매물들의 매매가(listings.sale_price)를 조회 시점에 MIN/MAX/AVG로 집계한 비영속 계산값이다(도메인 §2, §5.5). 매물이 0건이면 문자열 \"매물 없음\"을 반환한다.",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "minPrice": { "type": "integer", "description": "만원", "example": 90000 },
              "maxPrice": { "type": "integer", "description": "만원", "example": 110000 },
              "avgPrice": { "type": "integer", "description": "만원", "example": 100000 }
            }
          },
          { "type": "string", "enum": ["매물 없음"] }
        ]
      },
      "ApartmentComplexSummary": {
        "type": "object",
        "description": "목록/join 용 단지 요약 정보(도메인 §4.1)",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "complexName": { "type": "string", "example": "동탄역 시범 우남퍼스트빌" },
          "address": { "type": "string", "example": "경기도 화성시 동탄역로 123" },
          "completionYear": { "type": "integer", "minimum": 1970, "example": 2021 },
          "remodelingStatus": { "$ref": "#/components/schemas/RemodelingStatus" },
          "reconstructionStatus": { "$ref": "#/components/schemas/ReconstructionStatus" },
          "isRegulatedArea": { "type": "boolean", "default": false, "example": true },
          "isLandTransactionPermissionZone": { "$ref": "#/components/schemas/LandTransactionPermissionZoneStatus" },
          "nearestShuttleStopName": { "type": "string", "nullable": true, "description": "배차 정보 미확보 시 null(\"정보 없음\" 표시, 도메인 §4.1)", "example": "동탄역 셔틀정류장" },
          "nearestShuttleStopDistance": { "type": "integer", "nullable": true, "description": "m", "example": 350 },
          "shuttleCommuteMinutes": { "type": "integer", "nullable": true, "description": "분", "example": 42 }
        }
      },
      "ApartmentComplex": {
        "type": "object",
        "description": "아파트 단지 상세(도메인 §4.1)",
        "allOf": [
          { "$ref": "#/components/schemas/ApartmentComplexSummary" },
          {
            "type": "object",
            "properties": {
              "latitude": { "type": "number", "format": "double", "example": 37.1996 },
              "longitude": { "type": "number", "format": "double", "example": 127.0982 },
              "remodelingCompletionYear": { "type": "integer", "nullable": true, "description": "리모델링 추진현황이 '완료'일 때만 값 존재", "example": null },
              "reconstructionStatus": { "$ref": "#/components/schemas/ReconstructionStatus" },
              "nearbyRedevelopmentInfo": { "type": "string", "nullable": true, "example": "OO구역 재개발 정비사업 조합설립인가 단계(2025)" },
              "localityAttributes": { "$ref": "#/components/schemas/LocalityAttributes" },
              "priceRange": { "$ref": "#/components/schemas/PriceRange" }
            }
          }
        ]
      },
      "Listing": {
        "type": "object",
        "description": "매물(개별 판매 건, 도메인 §4.2). 소속 단지 정보를 join하여 함께 반환한다.",
        "properties": {
          "id": { "type": "integer", "example": 10 },
          "complexId": { "type": "integer", "example": 1 },
          "salePrice": { "type": "integer", "description": "매매가(만원), 70000~150000", "minimum": 70000, "maximum": 150000, "example": 95000 },
          "exclusiveArea": { "type": "number", "format": "double", "description": "전용면적(m^2), > 0", "example": 84.98 },
          "complex": {
            "allOf": [
              { "$ref": "#/components/schemas/ApartmentComplexSummary" },
              {
                "type": "object",
                "properties": {
                  "latitude": { "type": "number", "format": "double", "example": 37.1996 },
                  "longitude": { "type": "number", "format": "double", "example": 127.0982 }
                }
              }
            ]
          }
        },
        "required": ["id", "complexId", "salePrice", "exclusiveArea"]
      },
      "FavoriteComplex": {
        "type": "object",
        "description": "단지 즐겨찾기(도메인 §4.4)",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "userProfileId": { "type": "integer", "example": 1 },
          "complexId": { "type": "integer", "example": 1 },
          "registeredAt": { "type": "string", "format": "date-time" },
          "complex": { "$ref": "#/components/schemas/ApartmentComplexSummary" }
        }
      },
      "FavoriteListing": {
        "type": "object",
        "description": "매물 즐겨찾기(도메인 §4.4)",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "userProfileId": { "type": "integer", "example": 1 },
          "listingId": { "type": "integer", "example": 10 },
          "registeredAt": { "type": "string", "format": "date-time" },
          "listing": { "$ref": "#/components/schemas/Listing" }
        }
      },
      "ComparisonSetCreateRequest": {
        "type": "object",
        "description": "비교셋 생성 요청. targetType에 따라 complexIds 또는 listingIds 중 하나만 사용한다(도메인 §4.5, 혼합 불가).",
        "properties": {
          "targetType": { "type": "string", "enum": ["complex", "listing"], "example": "complex" },
          "complexIds": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 5, "example": [1, 2, 3] },
          "listingIds": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 5, "example": [10, 11] }
        },
        "required": ["targetType"]
      },
      "ComparisonComplexItem": {
        "type": "object",
        "description": "단지 비교 시 단지별 비교 데이터(도메인 §5.5)",
        "properties": {
          "complexId": { "type": "integer", "example": 1 },
          "complexName": { "type": "string", "example": "동탄역 시범 우남퍼스트빌" },
          "completionYear": { "type": "integer", "example": 2021 },
          "remodelingStatus": { "$ref": "#/components/schemas/RemodelingStatus" },
          "reconstructionStatus": { "$ref": "#/components/schemas/ReconstructionStatus" },
          "nearbyRedevelopmentInfo": { "type": "string", "nullable": true, "example": "정보 없음" },
          "localityAttributes": { "$ref": "#/components/schemas/LocalityAttributes" },
          "shuttleCommuteMinutes": { "type": "integer", "nullable": true, "example": 42 },
          "priceRange": { "$ref": "#/components/schemas/PriceRange" }
        }
      },
      "ComparisonListingItem": {
        "type": "object",
        "description": "매물 비교 시 매물별 비교 데이터. 소속 단지 축을 함께 포함하며, 동일 단지 매물끼리 비교 시 단지 축 값은 모든 대상에서 동일하다(도메인 §5.5, 정상 동작)",
        "properties": {
          "listingId": { "type": "integer", "example": 10 },
          "complexId": { "type": "integer", "example": 1 },
          "salePrice": { "type": "integer", "example": 95000 },
          "exclusiveArea": { "type": "number", "example": 84.98 },
          "complexName": { "type": "string", "example": "동탄역 시범 우남퍼스트빌" },
          "completionYear": { "type": "integer", "example": 2021 },
          "remodelingStatus": { "$ref": "#/components/schemas/RemodelingStatus" },
          "reconstructionStatus": { "$ref": "#/components/schemas/ReconstructionStatus" },
          "nearbyRedevelopmentInfo": { "type": "string", "nullable": true, "example": "정보 없음" },
          "localityAttributes": { "$ref": "#/components/schemas/LocalityAttributes" },
          "shuttleCommuteMinutes": { "type": "integer", "nullable": true, "example": 42 }
        }
      },
      "ComparisonSetSummary": {
        "type": "object",
        "description": "비교셋 목록 조회 시 항목별 요약 정보. itemNames는 단지 비교인 경우 단지명, 매물 비교인 경우 \"단지명 매매가만원\" 형태의 짧은 라벨 배열이다.",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "targetType": { "type": "string", "enum": ["complex", "listing"], "example": "complex" },
          "createdAt": { "type": "string", "format": "date-time" },
          "itemCount": { "type": "integer", "example": 3 },
          "itemNames": { "type": "array", "items": { "type": "string" }, "example": ["동탄역 시범 우남퍼스트빌", "평택 소사벌 한라비발디", "위례신도시 롯데캐슬"] }
        }
      },
      "ComparisonSetDetail": {
        "type": "object",
        "description": "비교셋 상세. targetType에 따라 complexes 또는 listings 중 하나만 채워진다(도메인 §4.5, §5.5).",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "userProfileId": { "type": "integer", "example": 1 },
          "targetType": { "type": "string", "enum": ["complex", "listing"], "example": "complex" },
          "createdAt": { "type": "string", "format": "date-time" },
          "complexes": { "type": "array", "items": { "$ref": "#/components/schemas/ComparisonComplexItem" }, "nullable": true },
          "listings": { "type": "array", "items": { "$ref": "#/components/schemas/ComparisonListingItem" }, "nullable": true }
        }
      },
      "RegulationInfo": {
        "type": "object",
        "description": "매물이 속한 단지 기준 규제/대출 분석 결과(도메인 §5.1~§5.2, PRD F4)",
        "properties": {
          "listingId": { "type": "integer", "example": 10 },
